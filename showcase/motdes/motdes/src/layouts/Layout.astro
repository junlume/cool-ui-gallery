---
import '@fontsource-variable/noto-sans-sc';
import '@fontsource-variable/ibm-plex-sans';
import '@fontsource/ibm-plex-mono/300.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource-variable/archivo';
// 与原站逐个对齐的自托管字体（原站同样自托管这三家，非 Adobe kit）
import '@fontsource/google-sans-code/400.css';   // 所有等宽标注：日期、分类、scroll 提示
import '@fontsource-variable/roboto';
import '@fontsource/barlow/500.css';             // 作品「战绩」数字
import '../styles/global.css';
import '../styles/chrome.css';
import '../styles/coin-opening.css';
import { PATH as M_PATH, VIEWBOX as M_VIEWBOX } from '../lib/glyph.js';
import { WORDMARK_PATH, WORDMARK_VIEWBOX } from '../lib/wordmark.js';
import { buildConstructionSVG, buildLogoOutlineSVG } from '../lib/construction-svg.js';
import { buildOutroSVG, buildOutroMarkSVG, buildOutroNameSVG } from '../lib/outro-svg.js';

const cons = buildConstructionSVG();
const logoOutline = buildLogoOutlineSVG();
const outroCons = buildOutroSVG();
const outroMark = buildOutroMarkSVG();
const outroName = buildOutroNameSVG();

// 右上斜箭头。原站 More Works 与页脚按钮共用同一枚，路径逐字取自原站 SVG。
const arrowIcon = `<svg width="12" height="12" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" clip-rule="evenodd" d="M1.57516 13.1495L11.8192 2.91846C11.7272 3.54646 11.6712 4.34046 11.6712 5.13446C11.6712 5.87346 11.7082 6.61246 11.8192 7.29546L12.9472 7.01846C12.8552 6.33546 12.8182 5.61446 12.8182 4.87646C12.8182 3.41746 12.9842 1.90346 13.2612 0.647461C12.0042 0.924461 10.4882 1.09046 9.02716 1.09046C8.28816 1.09046 7.56616 1.05346 6.88216 0.961461L6.60516 2.08746C7.28916 2.19846 8.02916 2.23546 8.76816 2.23546C9.56316 2.23546 10.3582 2.18046 10.9872 2.08746L0.743164 12.3185L1.57516 13.1495Z" fill="#7E7E7E"/></svg>`;

interface Props {
  page: string;
  title: string;
  description?: string;
}
const { page, title, description = 'motdes 是一间为数字原生时代创造前所未有的娱乐体验的创意工作室。' } = Astro.props;

// 社交入口。原站是 TECHBLOG / note / X / YouTube 四条，这里保留同样的槽位。
const social = [
  { label: 'TECHBLOG', href: '#' },
  { label: 'note', href: '#' },
  { label: 'X', href: '#' },
  { label: 'YouTube', href: '#' },
];

const nav = [
  { page: 'news', label: 'News', href: '/news' },
  { page: 'works', label: 'Works', href: '/works' },
  { page: 'about', label: 'About', href: '/about' },
  { page: 'stellla', label: 'stellla', href: '/stellla' },
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#000000" />
    {/* 标志取自字标里的 M（tools/build-favicon.mjs 生成，真源同 wordmark.svg）。
        SVG 优先（高分屏边缘更实），PNG 是不支持 SVG 图标时的兜底。 */}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.png" sizes="48x48" />
  </head>

  <body data-page={page} data-phase="ready" data-gl_loading_end="false" data-page_changed="false" data-coin-opening={page === 'top' ? 'true' : undefined} data-coin-state={page === 'top' ? 'loading' : undefined}>
    {page === 'top' && (
      <>
        <div class="CoinOpening" id="coin-opening" aria-label="开场动画">
          <video id="coin-intro-video" class="CoinOpening__video" muted playsinline preload="auto" poster="/top/coin/intro-poster.jpg" data-arrival-start="9.066667">
            <source src="/top/coin/intro-grab-pullback.mp4" type="video/mp4" />
          </video>
          <div class="CoinOpening__progress" id="coin-progress" role="progressbar" aria-label="加载中" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
            <span class="CoinOpening__label">加载中</span>
            <span data-coin-percent>0</span><span class="CoinOpening__percent">%</span>
          </div>
          <button type="button" class="CoinOpening__skip" id="coin-skip">跳过动画</button>
        </div>
        <video id="coin-loop-video" class="CoinOpening__texture" muted playsinline loop preload="auto" aria-hidden="true" tabIndex="-1">
          <source src="/top/coin/loop-pullback.mp4" type="video/mp4" />
        </video>
        <div class="CoinOpening__scroll" aria-hidden="true">向下滚动，继续探索<span>↓</span></div>
        <audio data-site-music data-opening-src="/sounds/opening-first.mp3" data-loop-src="/sounds/ambient-loop.mp3" src="/sounds/opening-first.mp3" preload="auto" aria-hidden="true"></audio>
        <button class="SiteMusic" data-music-toggle type="button" aria-label="开启音乐" aria-pressed="false" hidden>点击开启声音</button>
      </>
    )}
    {/* ============ 开场 loading ============ */}
    <div id="loading-overlay" class="Loading__container">
      <div class="Loading__lottieContainer">
        {/* 构造线与字标描边都由 src/lib/glyph.js 派生 —— 与三维字标同源 */}
        <div id="loading-lottie" class="Loading__lottie">
          <svg class="Loading__svg" viewBox={cons.viewBox} fill="none" xmlns="http://www.w3.org/2000/svg"
               preserveAspectRatio="xMidYMid slice" set:html={cons.markup} />
        </div>
        <div id="loading-logo" class="Loading__logo">
          <svg class="Loading__svg Loading__logo_svg" viewBox={logoOutline.viewBox} fill="none"
               xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid slice" set:html={logoOutline.markup} />
        </div>
      </div>
      <div id="loading-text" class="Loading__text">
        Building worlds<br />that move hearts and carry hope.
      </div>
    </div>

    {/* ============ Header ============ */}
    <header class="Header__container">
      <div class="Header__logo">
        {/* 字标来自 brand/motdes-wordmark.svg。原站 width=120 对应帽高 25px，
            MOTDES 帽高 145.45、总宽 854.9，等帽高换算下来就是 147px */}
        <a href="/" aria-label="motdes">
          <svg width="147" viewBox={WORDMARK_VIEWBOX} fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d={WORDMARK_PATH} fill="white" />
          </svg>
        </a>
      </div>

      <nav class="Header__nav">
        {nav.map((n) => (
          <div class="Header__nav_item" data-page={n.page}>
            <a href={n.href}><span>{n.label}</span></a>
          </div>
        ))}
      </nav>

      <div class="Header__right_controls">
        <a href="/contact" class="SlotButton__button Header__contact">
          <span class="SlotButton__text_wrapper">
            <span class="SlotButton__text">Contact / Recruit</span>
            <span class="SlotButton__text_hover">Contact / Recruit</span>
          </span>
        </a>
      </div>
    </header>

    {/* ============ 首访声音确认条 ============ */}
    <div class="SoundIntro__overlay" id="sound-intro" data-state="hidden" aria-hidden="true">
      <div class="SoundIntro__panel" data-sound-intro-panel role="dialog" aria-modal="false" aria-labelledby="sound-intro-text">
        <span class="SoundIntro__rule"></span>
        <div class="SoundIntro__inner">
          <p class="SoundIntro__label"><span class="SoundIntro__marker"></span>sound</p>
          <p class="SoundIntro__text" id="sound-intro-text">本站包含声音，是否开启？</p>
          <div class="SoundIntro__actions">
            <button class="SoundIntro__accept" data-sound-intro-accept type="button">开启声音</button>
            <button class="SoundIntro__decline" data-sound-intro-decline type="button">静音继续</button>
          </div>
        </div>
      </div>
    </div>
    <div class="SoundIntro__hint" id="sound-hint" data-state="hidden" aria-hidden="true">
      <span class="SoundIntro__hint_line"></span>
      <p class="SoundIntro__hint_text" data-sound-hint-text></p>
    </div>

    {/* ============ 主体 ============ */}
    <div class="Layout__wrapper">
      <div class="Layout__gl">
        <div class="Layout__gl_inner">
          <div id="gl-canvas" class="GLCanvas__container"></div>
        </div>
      </div>
      <div class="Layout__inner">
        <main id="swup" class="Layout__main">
          <div><slot /></div>
        </main>
      </div>
    </div>

    {/* ============ outro ============ */}
    <div class="TopPageOutro__wrapper" data-outro-wrapper>
      <div class="TopPageOutro__screen">
        <canvas class="TopPageOutro__canvas" id="outro-canvas"></canvas>
        <div class="TopPageOutro__screen_inner">
          {/* 收场的构造图纸。规则与开场那张同源，对象换成整幅字标 —— 见 lib/outro-svg.js */}
          <div data-outro-lottie class="TopPageOutro__lottie">
            <svg class="Outro__svg" viewBox={outroCons.viewBox} fill="none"
                 xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid slice"
                 set:html={outroCons.markup} />
          </div>
          <div class="TopPageOutro__logo" data-outro-logo>
            {/* 六个字母先完整描边，再由 M 到 S 从左到右逐字填实。 */}
            <svg class="Outro__mark" viewBox={outroMark.viewBox} fill="none"
                 xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid slice" role="img" aria-label={`MOTDES → ${outroName.text}`}>
              {outroMark.glyphs.map((g, i) => (
                <path d={g.d} data-outro-mark={g.isMark ? '' : undefined}
                      data-outro-glyph={i} pathLength="1" />
              ))}
              <g class="Outro__name" transform={outroName.transform} aria-hidden="true">
                {outroName.glyphs.map((g, i) => (
                  <path d={g.d} data-outro-name-glyph={i} />
                ))}
              </g>
            </svg>
          </div>
        </div>
      </div>
    </div>

    {/* ============ Footer ============ */}
    <footer class="Footer__footer">
      <div class="Footer__inner">
        <div class="Footer__top">
          {/* 页脚左侧两列页面链接：用户 2026-08-28 要求删掉 */}
          {/* 右侧 Links 区块（TECH BLOG / Notes / X / YouTube）：用户要求删掉 */}
                </div>
        <div class="Footer__top_contact">
          <div class="Footer__contact">
            <a href="/contact" class="Footer__contact_button">
              <span class="Footer__contact_button_text" data-scramble>Contact</span>
              <span class="Footer__contact_button_icon" set:html={arrowIcon} />
            </a>
            {/* Recruit 按钮：在用户圈选的范围内，一并删掉 */}
          </div>
          {/* Privacy Policy / License：用户要求删掉 */}
        </div>
        {/* ©2026 motdes, Inc.：用户要求删掉 */}
        <div class="Footer__logo" aria-hidden="true">
          <svg viewBox={WORDMARK_VIEWBOX} fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d={WORDMARK_PATH} fill="currentColor" />
          </svg>
        </div>
      </div>
    </footer>

    <script>
      import '../scripts/main.js';
    </script>
  </body>
</html>
